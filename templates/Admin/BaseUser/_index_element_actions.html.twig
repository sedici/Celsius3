{% extends 'BaseUser/_index_element_actions.html.twig' %}

{% block extraactions %}
    <li>
        <a href="{{ path('admin_user_show', {'id': element.id}) }}">
            <span class="glyphicon glyphicon-eye-open"></span> {{ 'Show' | trans }}
        </a>
    </li>
    {% if (element.username is not empty) %}
        <li>
            {# <a href="{{ path('reset_password_from_admin', {'userId': element.id}) }}">
                <span class="glyphicon glyphicon-option-horizontal"></span> {{ 'Reset password' | trans }}
            </a> #}

            <li>
                <form
                action="{{ path('reset_password_from_admin', {'userId': element.id}) }}"
                method="post">
                    <button
                    type="submit"
                    style="background: none!important;
                    border: none;
                    padding: 0!important;"><a>
                        <span class="glyphicon glyphicon-option-horizontal"></span>
                        {{ 'Reset password' | trans }}
                    </a></button>
                </form>
        </li>

        {% if not is_granted('ROLE_PREVIOUS_ADMIN') %}
            <li>
                <a href="{{ path('switch_user', {'_switch_user': element.id}) }}">
                    <span class="glyphicon glyphicon-log-in"></span> {{ 'Login as' | trans }}
                </a>
            </li>
        {% endif %}
    {% endif %}
{% endblock %}
