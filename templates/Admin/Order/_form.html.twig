{% form_theme form 'Form/fields.html.twig' %}

<div class="row">
    <div class="col-md-4">
        {{ form_row(form.originalRequest.type, {
            label_attr: {'class': 'col-lg-2 control-label'},
            attr: {'class': 'form-control'}
        }) }}
    </div>
    <div class="col-md-8">
        {{ form_row(form.originalRequest.owner_autocomplete, {
            label_attr: {'class': 'col-lg-2 control-label'},
            attr: {'class': 'autocomplete form-control'}
        }) }}
    </div>
</div>
<div class="row" style="margin-bottom: 20px;">
    <div class="col-md-12">
        {{ form_row(form.materialDataType, {
            label_attr: {'class': 'col-lg-2 control-label'},
            attr: {'class': 'form-control'}
        }) }}
    </div>
</div>
<br>
<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <div id="material_data">
            {% set material = (entity is defined and entity is not null and entity.materialData is not null)
                ? get_material_type(entity.materialData)
                : 'journal'
            %}
            {% include 'Order/_materialData.html.twig' %}
        </div>
    </div>
</div>
<br>
<div class="row">
    <div class="col-md-12">
        {{ form_row(form.originalRequest.comments) }}
    </div>
</div>
{% if form.save_and_show is defined %}
    {{ form_row(form.save_and_show) }}
{% endif %}

{{ form_rest(form.originalRequest) }}
{{ form_widget(form._token) }}


