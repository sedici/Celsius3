{% extends 'Layout/layout.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block content %}
    <p>
        An email was just sent that contains a link that you can use to reset your password.
        This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>
    <p>If you don't receive an email please check your spam folder or <a href="{{ path('password_forgotten') }}">try again</a>.</p>
{% endblock %}
