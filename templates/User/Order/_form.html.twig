{% form_theme form 'Form/fields.html.twig' %}

<div class="row" style="margin-bottom: 20px;">
    {% if form.originalRequest.target is defined %}
        <div class="col-md-6">
            {{ form_row(form.originalRequest.target) }}
        </div>
    {% endif %}

    {% if form.originalRequest.owner_autocomplete is defined %}
        <div class="col-md-6">
            {{ form_row(form.originalRequest.owner_autocomplete, {
                attr: {'class': 'form-control'}
            }) }}
        </div>
    {% endif %}

    <div class="col-md-12">
        {{ form_row(form.materialDataType) }}
    </div>
</div>
<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <div id="material_data">
            {% set material = (entity is defined and entity.materialData is not null)
                ? get_material_type(entity.materialData)
                : 'journal'
            %}
            {% include 'Order/_materialData.html.twig' %}
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        {{ form_row(form.originalRequest.comments) }}
    </div>
</div>
{% if form.save_and_show is defined %}
    {{ form_row(form.save_and_show) }}
{% endif %}

{{ form_rest(form.originalRequest) }}
{{ form_widget(form._token) }}
